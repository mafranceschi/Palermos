# Datos del proyecto de Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password compartido del taller para entrar al sistema
APP_PASSWORD=cambiar-esta-clave

# Secreto usado para firmar la cookie de sesión del login (cualquier string largo y random)
SESSION_SECRET=cambiar-por-un-string-random-largo
